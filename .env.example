# 信号来源：heuristic、codex 或 openai
AI_PROVIDER=codex
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
CODEX_BIN=
CODEX_MODEL=
CODEX_TIMEOUT_SECONDS=90

# 本地模拟盘的数据库文件
PAPER_DB_PATH=data/paper_trading.sqlite3

# 可以填写一个数据源，也可以按顺序填写备用链，例如 akshare,yahoo
MARKET_DATA=akshare,yahoo
TUSHARE_TOKEN=

# paper 为本地模拟盘；alpaca、qmt 和 ptrade 会调用相应适配器
BROKER=paper
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true
ORDER_TYPE=limit
LIVE_TRADING_ACK=

# QMT / MiniQMT。QMT_PATH 通常指向 userdata_mini 目录
QMT_PATH=
QMT_ACCOUNT_ID=
QMT_ACCOUNT_TYPE=STOCK
QMT_SESSION_ID=123456

# PTrade 无法从平台上下文读取资产时使用的默认值
PTRADE_ACCOUNT_CASH=100000
PTRADE_DAY_START_EQUITY=100000

# 默认观察宽基、行业和跨市场 ETF，可按需要删减
SYMBOLS=510300.SH,510500.SH,512100.SH,588000.SH,159915.SZ,512880.SH,512890.SH,518880.SH,511260.SH,513100.SH

# 模拟账户与风控参数
STARTING_CASH=100000
MAX_TRADE_CASH=10000
MAX_ORDER_SHARES=2500
MAX_POSITION_PCT=0.50
MAX_DAILY_LOSS_PCT=0.015
STOP_LOSS_PCT=0.20
TAKE_PROFIT_PCT=0.50

# 默认必须保持为 true；启用真实报单前请先阅读对应适配器代码
DRY_RUN=true
