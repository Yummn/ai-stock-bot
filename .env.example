AI_PROVIDER=codex
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
CODEX_BIN=
CODEX_MODEL=
CODEX_TIMEOUT_SECONDS=90
PAPER_DB_PATH=data/paper_trading.sqlite3

# MARKET_DATA can be one provider or a comma-separated fallback chain: akshare,yahoo
MARKET_DATA=akshare,yahoo
TUSHARE_TOKEN=

# BROKER=paper is local simulation. BROKER=alpaca uses Alpaca's API.
BROKER=paper
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true
ORDER_TYPE=limit
LIVE_TRADING_ACK=

# QMT / MiniQMT. QMT_PATH is usually the userdata_mini directory.
QMT_PATH=
QMT_ACCOUNT_ID=
QMT_ACCOUNT_TYPE=STOCK
QMT_SESSION_ID=123456

# PTrade adapter defaults used when the platform context cannot expose portfolio values.
PTRADE_ACCOUNT_CASH=100000
PTRADE_DAY_START_EQUITY=100000

# Beginner simulation preset: broad asset ETFs instead of single-name stocks.
# 510300.SH = CSI 300 ETF, 510500.SH = CSI 500 ETF, 512100.SH = CSI 1000 ETF
# 588000.SH = STAR 50 ETF, 159915.SZ = ChiNext ETF, 512880.SH = Securities ETF
# 512890.SH = Dividend Low Vol ETF, 518880.SH = Gold ETF
# 511260.SH = 10Y Treasury ETF, 513100.SH = Nasdaq ETF
SYMBOLS=510300.SH,510500.SH,512100.SH,588000.SH,159915.SZ,512880.SH,512890.SH,518880.SH,511260.SH,513100.SH

STARTING_CASH=100000
MAX_TRADE_CASH=10000
MAX_ORDER_SHARES=2500
MAX_POSITION_PCT=0.50
MAX_DAILY_LOSS_PCT=0.015
STOP_LOSS_PCT=0.20
TAKE_PROFIT_PCT=0.50
DRY_RUN=true
